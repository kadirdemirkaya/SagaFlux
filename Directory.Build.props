<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <Version>1.2.0</Version>
    <Authors>kadirkdr</Authors>
    <Copyright>Copyright (c) 2026 Kadir Demirkaya</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>saga;state-machine;process-manager;cqrs;eventflux;dotnet;event-driven;compensation</PackageTags>
    <RepositoryUrl>https://github.com/kadirdemirkaya/SagaFlux</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/kadirdemirkaya/SagaFlux</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <MicrosoftExtensionsVersion>8.0.1</MicrosoftExtensionsVersion>
    <EfCoreSqliteVersion>8.0.31</EfCoreSqliteVersion>
    <AspNetCoreTestHostVersion>8.0.31</AspNetCoreTestHostVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <MicrosoftExtensionsVersion>9.0.20</MicrosoftExtensionsVersion>
    <EfCoreSqliteVersion>9.0.20</EfCoreSqliteVersion>
    <AspNetCoreTestHostVersion>9.0.20</AspNetCoreTestHostVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
    <EfCoreSqliteVersion>10.0.12</EfCoreSqliteVersion>
    <AspNetCoreTestHostVersion>10.0.12</AspNetCoreTestHostVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('/src/')) Or $(MSBuildProjectDirectory.Contains('\src\'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Source Link (built into the .NET 8 SDK) and a .snupkg symbol package next to each .nupkg -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('/test/')) Or $(MSBuildProjectDirectory.Contains('\test\'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
</Project>
