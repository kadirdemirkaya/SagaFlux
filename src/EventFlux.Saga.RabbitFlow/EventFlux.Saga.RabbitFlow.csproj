<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>EventFlux.Saga.RabbitFlow</PackageId>
    <Description>RabbitMQ transport adapter for EventFlux.Saga on top of EventFlux.RabbitFlow: sagas publish and receive their events through RabbitMQ without changing the saga definition.</Description>
    <PackageTags>$(PackageTags);rabbitmq;distributed</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EventFlux.RabbitFlow" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventFlux.Saga\EventFlux.Saga.csproj" />
  </ItemGroup>

</Project>
